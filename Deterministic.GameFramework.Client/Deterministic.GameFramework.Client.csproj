<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>Latest</LangVersion>
        <RootNamespace>Deterministic.GameFramework.Client</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="ToAdd\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
      <PackageReference Include="ObservableCollections" Version="3.3.1" />
      <PackageReference Include="R3" Version="1.2.15" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Deterministic.GameFramework.Network\Deterministic.GameFramework.Network.csproj" />
    </ItemGroup>

    <!-- Copy netstandard2.1 DLL to Unity client Plugins folder after build -->
    <Target Name="CopyToUnityClient" AfterTargets="Build" Condition="'$(TargetFramework)' == 'netstandard2.1' AND '$(UnityClientPath)' != ''">
        <PropertyGroup>
            <UnityPluginsDir>$(UnityClientPath)\Assets\Plugins\Framework\</UnityPluginsDir>
        </PropertyGroup>
        <MakeDir Directories="$(UnityPluginsDir)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityPluginsDir)" SkipUnchangedFiles="true" />
    </Target>

</Project>
