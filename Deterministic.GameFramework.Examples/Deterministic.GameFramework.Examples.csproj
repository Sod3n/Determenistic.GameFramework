<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>Latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Deterministic.GameFramework.Core\Deterministic.GameFramework.Core.csproj" />
        <ProjectReference Include="..\Deterministic.GameFramework.Server\Deterministic.GameFramework.Server.csproj" />
        <ProjectReference Include="..\Deterministic.GameFramework.Network\Deterministic.GameFramework.Network.csproj" />
        <ProjectReference Include="..\Deterministic.GameFramework.SourceGenerators\Deterministic.GameFramework.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Examples\MultiplayerHelloWorld\**" />
        <EmbeddedResource Remove="Examples\MultiplayerHelloWorld\**" />
        <None Remove="Examples\MultiplayerHelloWorld\**" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Examples\Advanced\Data\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Import our custom MSBuild target -->
    <Import Project="..\Deterministic.GameFramework.BuildTasks\build\Deterministic.GameFramework.targets" />

</Project>
